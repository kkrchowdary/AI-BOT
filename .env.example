# Example environment variables for AI-BOT

# Host/port configuration for uvicorn (optional)
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Ollama connection settings (if required by your environment)
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# Any API keys for external services (e.g., weather provider)
WEATHER_API_KEY=
WEATHER_API_URL=

