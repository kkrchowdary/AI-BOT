{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Uvicorn",
      "type": "shell",
      "command": "uvicorn main:app --reload --port 8000",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run Uvicorn (debugpy)",
      "type": "shell",
      "command": "python -m debugpy --listen 5678 --wait-for-client -m uvicorn main:app --reload",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
